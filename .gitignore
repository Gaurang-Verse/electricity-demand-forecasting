# Python
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# Environment / secrets
.env

# Data is never committed (see docs/dataset.md for how to get it).
# The exception is a handful of small JSON files with measured results,
# so the numbers quoted in the docs can be checked against the source.
data/raw/
data/processed/*
!data/processed/.gitkeep
!data/processed/backtest_results.json
!data/processed/holdout_results.json

# The shipped model artifact (data/processed/model/) is a binary + its
# metadata, both regenerable by scripts/evaluate_holdout.py. Not committed;
# the Docker build produces it fresh, same reasoning as Project A's model
# checkpoint.

# Model artifacts are binaries and stay out of git.
*.pkl
*.joblib
*.txt.model

# MLflow local tracking store
mlruns/
mlflow.db

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store
